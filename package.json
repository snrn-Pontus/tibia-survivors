{
  "name": "tibia-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fetch-data": "python tools/fetch_tibia_data.py",
    "extract": "python tools/extract.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim": "esbuild tools/simulate.ts --bundle --platform=node --outfile=tools/.cache/sim.cjs --log-level=warning && node tools/.cache/sim.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
